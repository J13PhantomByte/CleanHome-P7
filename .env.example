# CleanHome Environment Variables Example
# Copy this file to .env.local for local development.

# Supabase Configuration
# Required for real Supabase authentication and PostgreSQL database queries.
# Retrieve these from your Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# NOTE ON SECURITY:
# VITE_SUPABASE_PUBLISHABLE_KEY is the client anon key, designed for browser-side requests.
# It is secured strictly by Row Level Security (RLS) policies in PostgreSQL.
# NEVER place SUPABASE_SERVICE_ROLE_KEY or any secret key in client-side VITE_ environment variables!

# Application URL
APP_URL="http://localhost:3000"
